{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "default:automergeDigest"
  ],
  "packageRules": [
    {
      "description": "Patch updates are merged automatically",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
