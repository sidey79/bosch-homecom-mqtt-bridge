# Set this to the MQTT endpoint reachable inside your FHEM Docker network (mqtt:// or mqtts://).
MQTT_URL=mqtt://fhem:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=bosch-homecom
MQTT_CLIENT_ID=bosch-homecom-mqtt-bridge
# Persistent state (refresh token) lives in the /data volume.
BOSCH_AUTH_PATH=/data/auth.json
# Account brand used for login and token exchange: bosch or buderus.
BOSCH_BRAND=bosch
# Optional: restrict the bridge to one gateway; `login` prints the available device IDs.
# BOSCH_DEVICE_ID=
# Seconds between polls, 30 to 3600.
BOSCH_POLL_INTERVAL=60
HEALTH_PORT=8080
LOG_LEVEL=info
# Seconds one discovery or poll may take before it is aborted, 60 to 900 (refreshes are never aborted).
BOSCH_POLL_TIMEOUT=300
